---
---

<div class="bg-white shadow-sm rounded-xl p-6 sm:p-8 border border-neutral-100">
  <form id="contact-form" class="space-y-6">
    <div class="grid grid-cols-1 gap-y-5 sm:grid-cols-2 sm:gap-x-6">
      <!-- 姓名 -->
      <div>
        <label for="name" class="block text-sm font-medium text-neutral-700 mb-1.5">
          <span class="text-red-500 font-bold">*</span> 姓名
        </label>
        <input
          type="text"
          name="name"
          id="name"
          required
          placeholder="請輸入姓名"
          class="w-full px-4 py-3 rounded-lg border border-neutral-300 focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-none transition-all text-sm"
        />
      </div>

      <!-- 聯絡電話 -->
      <div>
        <label for="phone" class="block text-sm font-medium text-neutral-700 mb-1.5">
          <span class="text-red-500 font-bold">*</span> 聯絡電話
        </label>
        <input
          type="tel"
          name="phone"
          id="phone"
          required
          placeholder="請輸入聯絡電話"
          class="w-full px-4 py-3 rounded-lg border border-neutral-300 focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-none transition-all text-sm"
        />
      </div>

      <!-- 案場縣市 -->
      <div>
        <label for="city" class="block text-sm font-medium text-neutral-700 mb-1.5">
          <span class="text-red-500 font-bold">*</span> 案場縣市
        </label>
        <input
          type="text"
          name="city"
          id="city"
          required
          placeholder="例如：台北市中山區"
          class="w-full px-4 py-3 rounded-lg border border-neutral-300 focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-none transition-all text-sm"
        />
      </div>

      <!-- 屋齡 -->
      <div>
        <label for="houseAge" class="block text-sm font-medium text-neutral-700 mb-1.5">
          <span class="text-red-500 font-bold">*</span> 屋齡
        </label>
        <input
          type="text"
          name="houseAge"
          id="houseAge"
          required
          placeholder="例如：新成屋 / 5年 / 老屋翻新"
          class="w-full px-4 py-3 rounded-lg border border-neutral-300 focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-none transition-all text-sm"
        />
      </div>

      <!-- 室內坪數 -->
      <div>
        <label for="indoorPing" class="block text-sm font-medium text-neutral-700 mb-1.5">
          <span class="text-red-500 font-bold">*</span> 室內坪數
        </label>
        <input
          type="text"
          name="indoorPing"
          id="indoorPing"
          required
          placeholder="例如：25 坪"
          class="w-full px-4 py-3 rounded-lg border border-neutral-300 focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-none transition-all text-sm"
        />
      </div>

      <!-- 裝修預算 -->
      <div>
        <label for="budget" class="block text-sm font-medium text-neutral-700 mb-1.5">
          <span class="text-red-500 font-bold">*</span> 裝修預算
        </label>
        <input
          type="text"
          name="budget"
          id="budget"
          required
          placeholder="例如：30-50萬 / 50-100萬"
          class="w-full px-4 py-3 rounded-lg border border-neutral-300 focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-none transition-all text-sm"
        />
      </div>
    </div>

    <!-- 需求說明 -->
    <div>
      <label for="message" class="block text-sm font-medium text-neutral-700 mb-1.5">
        需求說明
      </label>
      <textarea
        id="message"
        name="message"
        rows="4"
        class="w-full px-4 py-3 rounded-lg border border-neutral-300 focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-none transition-all text-sm placeholder-neutral-400"
        placeholder="請簡述您的需求，例如：客廳電視櫃、主臥衣櫃、全室收納規劃等..."
      ></textarea>
    </div>

    <!-- Turnstile 機器人驗證 -->
    <div class="cf-turnstile" data-sitekey="0x4AAAAAAEc7seHstUiTIDCi" data-theme="light"></div>

    <!-- Submit Button -->
    <div>
      <button
        type="submit"
        class="w-full flex justify-center py-3.5 px-4 border border-transparent rounded-lg shadow-sm text-base font-medium text-white bg-brand-primary hover:bg-brand-secondary focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-primary transition-colors cursor-pointer"
      >
        送出表單
      </button>
    </div>
    
    <div id="form-status" class="hidden rounded-md p-4 mt-4">
      <p id="form-message" class="text-sm font-medium"></p>
    </div>
  </form>
</div>


<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const formStatus = document.getElementById('form-status');
  const formMessage = document.getElementById('form-message');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // 檢查 Turnstile 驗證
      const turnstileResponse = form.querySelector<HTMLInputElement>('[name="cf-turnstile-response"]');
      if (!turnstileResponse || !turnstileResponse.value) {
        if (formStatus && formMessage) {
          formStatus.className = 'rounded-md p-4 mt-4 bg-red-50 text-red-800 block';
          formMessage.textContent = '請完成機器人驗證。';
        }
        return;
      }
      
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      
      submitBtn.disabled = true;
      submitBtn.textContent = '傳送中...';

      try {
        const formData = new FormData(form);
        const data = {
          name: formData.get('name'),
          phone: formData.get('phone'),
          city: formData.get('city'),
          houseAge: formData.get('houseAge'),
          indoorPing: formData.get('indoorPing'),
          budget: formData.get('budget'),
          message: formData.get('message'),
          turnstileToken: turnstileResponse.value,
        };

        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        const result = await response.json() as { error?: string };

        if (formStatus && formMessage) {
          if (response.ok) {
            formStatus.className = 'rounded-md p-4 mt-4 bg-green-50 text-green-800 block';
            formMessage.textContent = '表單已成功送出！我們會盡快與您聯絡。';
            form.reset();
            // 重置 Turnstile
            if ((window as any).turnstile) (window as any).turnstile.reset();
          } else {
            formStatus.className = 'rounded-md p-4 mt-4 bg-red-50 text-red-800 block';
            formMessage.textContent = result.error || '送出失敗，請稍後再試。';
          }
        }
      } catch (error) {
        if (formStatus && formMessage) {
          formStatus.className = 'rounded-md p-4 mt-4 bg-red-50 text-red-800 block';
          formMessage.textContent = '送出失敗，請稍後再試或直接來電聯絡。';
        }
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = '送出表單';
      }
    });
  }
</script>
