---
---

<div class="bg-white shadow-sm rounded-xl p-6 sm:p-8 border border-neutral-100">
  <form id="contact-form" class="space-y-6">
    <div class="grid grid-cols-1 gap-y-5 sm:grid-cols-2 sm:gap-x-6">
      <!-- 姓名 -->
      <div>
        <label for="name" class="block text-sm font-medium text-neutral-700 mb-1.5">
          <span class="text-red-500 font-bold" aria-hidden="true">*</span> 姓名
        </label>
        <input
          type="text"
          name="name"
          id="name"
          required
          autocomplete="name"
          placeholder="請輸入姓名"
          aria-invalid="false"
          class="w-full px-4 py-3 rounded-lg border border-neutral-300 focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary focus-visible:outline-2 focus-visible:outline-brand-primary transition-all text-base sm:text-sm"
        />
      </div>

      <!-- 電子信箱（選填） -->
      <div>
        <label for="email" class="block text-sm font-medium text-neutral-700 mb-1.5">
          電子信箱
          <span class="text-xs font-normal text-neutral-500 ml-1">（選填）</span>
        </label>
        <input
          type="email"
          name="email"
          id="email"
          autocomplete="email"
          autocapitalize="none"
          autocorrect="off"
          spellcheck="false"
          pattern={String.raw`[^\s@]+@[^\s@]+\.[^\s@]{2,}`}
          placeholder="例如：name@example.com"
          data-error="email-error"
          aria-invalid="false"
          class="w-full px-4 py-3 rounded-lg border border-neutral-300 focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary focus-visible:outline-2 focus-visible:outline-brand-primary transition-all text-base sm:text-sm"
        />
        <p id="email-error" class="field-error mt-1.5 text-xs text-red-600">
          <span role="img" aria-label="錯誤">⚠</span> 請輸入正確的電子信箱格式（例如：name@example.com）。
        </p>
      </div>

      <!-- 聯絡電話（手機 / 市話切換＋分機） -->
      <div class="sm:col-span-2">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-1.5">
          <label for="phone" class="block text-sm font-medium text-neutral-700">
            <span class="text-red-500 font-bold" aria-hidden="true">*</span> 聯絡電話
            <span id="phone-hint" class="text-xs font-normal text-neutral-500 ml-1">（09 開頭 10 碼）</span>
          </label>
          <fieldset class="inline-flex items-center rounded-lg bg-neutral-100 p-0.5 border border-neutral-200/80">
            <legend class="sr-only">電話類型</legend>
            <label class="cursor-pointer">
              <input type="radio" name="phoneType" value="mobile" checked class="sr-only peer" />
              <span class="block px-3 py-1 rounded-md text-xs font-medium text-neutral-600 transition-all peer-checked:bg-white peer-checked:text-brand-primary peer-checked:shadow-sm peer-focus-visible:outline-2 peer-focus-visible:outline-brand-primary">
                手機
              </span>
            </label>
            <label class="cursor-pointer">
              <input type="radio" name="phoneType" value="landline" class="sr-only peer" />
              <span class="block px-3 py-1 rounded-md text-xs font-medium text-neutral-600 transition-all peer-checked:bg-white peer-checked:text-brand-primary peer-checked:shadow-sm peer-focus-visible:outline-2 peer-focus-visible:outline-brand-primary">
                市話
              </span>
            </label>
          </fieldset>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 items-start">
          <div class="w-full sm:flex-1">
            <input
              type="tel"
              name="phone"
              id="phone"
              required
              inputmode="numeric"
              autocomplete="tel"
              maxlength="10"
              pattern="09[0-9]{8}"
              placeholder="例如：0912345678"
              data-error="phone-error"
              aria-invalid="false"
              class="w-full px-4 py-3 rounded-lg border border-neutral-300 focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary focus-visible:outline-2 focus-visible:outline-brand-primary transition-all text-base sm:text-sm"
            />
            <p id="phone-error" class="field-error mt-1.5 text-xs text-red-600">
              <span role="img" aria-label="錯誤">⚠</span>
              <span id="phone-error-text">請輸入 09 開頭的 10 位手機號碼（例如：0912345678）。</span>
            </p>
          </div>

          <div id="phone-ext-wrapper" class="hidden w-full sm:w-44 shrink-0">
            <label for="phoneExt" class="sr-only">分機號碼（選填）</label>
            <div class="relative">
              <span
                aria-hidden="true"
                class="pointer-events-none absolute inset-y-0 left-3.5 flex items-center text-sm text-neutral-400"
              >#</span>
              <input
                type="tel"
                name="phoneExt"
                id="phoneExt"
                disabled
                inputmode="numeric"
                maxlength="6"
                pattern="[0-9]{1,6}"
                placeholder="分機（選填）"
                data-error="phone-ext-error"
                aria-invalid="false"
                class="w-full pl-8 pr-4 py-3 rounded-lg border border-neutral-300 focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary focus-visible:outline-2 focus-visible:outline-brand-primary transition-all text-base sm:text-sm"
              />
            </div>
            <p id="phone-ext-error" class="field-error mt-1.5 text-xs text-red-600">
              <span role="img" aria-label="錯誤">⚠</span> 分機請輸入 1–6 位純數字。
            </p>
          </div>
        </div>
      </div>

      <!-- 案場縣市 -->
      <div>
        <label for="city" class="block text-sm font-medium text-neutral-700 mb-1.5">
          <span class="text-red-500 font-bold" aria-hidden="true">*</span> 案場縣市
        </label>
        <input
          type="text"
          name="city"
          id="city"
          required
          placeholder="例如：台北市中山區"
          aria-invalid="false"
          class="w-full px-4 py-3 rounded-lg border border-neutral-300 focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary focus-visible:outline-2 focus-visible:outline-brand-primary transition-all text-base sm:text-sm"
        />
      </div>

      <!-- 屋齡 -->
      <div>
        <label for="houseAge" class="block text-sm font-medium text-neutral-700 mb-1.5">
          <span class="text-red-500 font-bold" aria-hidden="true">*</span> 屋齡
        </label>
        <input
          type="text"
          name="houseAge"
          id="houseAge"
          required
          placeholder="例如：新成屋 / 5年 / 老屋翻新"
          aria-invalid="false"
          class="w-full px-4 py-3 rounded-lg border border-neutral-300 focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary focus-visible:outline-2 focus-visible:outline-brand-primary transition-all text-base sm:text-sm"
        />
      </div>

      <!-- 室內坪數 -->
      <div>
        <label for="indoorPing" class="block text-sm font-medium text-neutral-700 mb-1.5">
          <span class="text-red-500 font-bold" aria-hidden="true">*</span> 室內坪數
        </label>
        <input
          type="text"
          name="indoorPing"
          id="indoorPing"
          required
          placeholder="例如：25 坪"
          aria-invalid="false"
          class="w-full px-4 py-3 rounded-lg border border-neutral-300 focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary focus-visible:outline-2 focus-visible:outline-brand-primary transition-all text-base sm:text-sm"
        />
      </div>

      <!-- 裝修預算 -->
      <div>
        <label for="budget" class="block text-sm font-medium text-neutral-700 mb-1.5">
          <span class="text-red-500 font-bold" aria-hidden="true">*</span> 裝修預算
        </label>
        <input
          type="text"
          name="budget"
          id="budget"
          required
          placeholder="例如：30-50萬 / 50-100萬"
          aria-invalid="false"
          class="w-full px-4 py-3 rounded-lg border border-neutral-300 focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary focus-visible:outline-2 focus-visible:outline-brand-primary transition-all text-base sm:text-sm"
        />
      </div>
    </div>

    <!-- 需求說明 -->
    <div>
      <label for="message" class="block text-sm font-medium text-neutral-700 mb-1.5">
        需求說明
      </label>
      <textarea
        id="message"
        name="message"
        rows="4"
        aria-invalid="false"
        class="w-full px-4 py-3 rounded-lg border border-neutral-300 focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary focus-visible:outline-2 focus-visible:outline-brand-primary transition-all text-base sm:text-sm placeholder-neutral-400"
        placeholder="請簡述您的需求，例如：客廳電視櫃、主臥衣櫃、全室收納規劃等..."
      ></textarea>
    </div>

    <!-- Turnstile 機器人驗證 -->
    <div class="cf-turnstile" data-sitekey="0x4AAAAAAEc7seHstUiTIDCi" data-theme="light"></div>

    <!-- Submit Button -->
    <div>
      <button
        type="submit"
        class="w-full flex justify-center py-3.5 px-4 border border-transparent rounded-lg shadow-sm text-base font-medium text-white bg-brand-primary hover:bg-brand-secondary focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-primary transition-colors cursor-pointer"
      >
        送出表單
      </button>
    </div>

    <div id="form-status" class="hidden rounded-md p-4 mt-4" role="status" aria-live="polite">
      <p id="form-message" class="text-sm font-medium"></p>
    </div>
  </form>
</div>

<style>
  .field-error {
    display: none;
  }

  #contact-form :is(input, textarea):user-invalid {
    border-color: #dc2626;
    background-color: #fef2f2;
  }

  #contact-form :is(input, textarea):user-invalid + .field-error,
  #contact-form .relative:has(input:user-invalid) + .field-error {
    display: block;
  }

  :global(.visually-hidden:where(:not(:focus-within, :active))) {
    position: absolute !important;
    clip-path: inset(50%) !important;
    overflow: hidden !important;
    width: 1px !important;
    height: 1px !important;
    margin: -1px !important;
    padding: 0 !important;
    border: 0 !important;
    white-space: nowrap !important;
  }
</style>

<script>
  const MOBILE_PHONE_REGEX = /^09\d{8}$/;
  const LANDLINE_PHONE_REGEX = /^(?:02\d{8}|04\d{7,8}|0[35678]\d{7})$/;
  const PHONE_EXT_REGEX = /^\d{1,6}$/;
  const EMAIL_REGEX = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  const MOBILE_PATTERN = '09[0-9]{8}';
  const LANDLINE_PATTERN = '(?:02[0-9]{8}|04[0-9]{7,8}|0[35678][0-9]{7})';

  function sanitizeDigits(raw: string, maxLen: number): string {
    return raw
      .replace(/[\uFF10-\uFF19]/g, (ch) => String.fromCharCode(ch.charCodeAt(0) - 0xfee0))
      .replace(/\D/g, '')
      .slice(0, maxLen);
  }

  // 動態載入 Turnstile script
  if (!document.querySelector('script[src*="challenges.cloudflare.com/turnstile"]')) {
    const s = document.createElement('script');
    s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
    s.async = true;
    s.defer = true;
    document.head.appendChild(s);
  }

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const phoneInput = document.getElementById('phone') as HTMLInputElement | null;
  const phoneExtInput = document.getElementById('phoneExt') as HTMLInputElement | null;
  const phoneExtWrapper = document.getElementById('phone-ext-wrapper');
  const phoneHint = document.getElementById('phone-hint');
  const phoneErrorText = document.getElementById('phone-error-text');
  const emailInput = document.getElementById('email') as HTMLInputElement | null;
  const formStatus = document.getElementById('form-status');
  const formMessage = document.getElementById('form-message');

  if (form) {
    type ValidatableControl = HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
    type PhoneType = 'mobile' | 'landline';

    const phoneTypeRadios = form.querySelectorAll<HTMLInputElement>('input[name="phoneType"]');

    const getPhoneType = (): PhoneType => {
      const checked = form.querySelector<HTMLInputElement>('input[name="phoneType"]:checked');
      return checked?.value === 'landline' ? 'landline' : 'mobile';
    };

    const isValidatableControl = (el: EventTarget | null): el is ValidatableControl =>
      el instanceof HTMLInputElement ||
      el instanceof HTMLTextAreaElement ||
      el instanceof HTMLSelectElement;

    const linkError = (el: ValidatableControl, shown: boolean) => {
      const errorId = el.dataset.error;
      if (!errorId) return;
      const ids = (el.getAttribute('aria-describedby') || '')
        .split(/\s+/)
        .filter((id) => id && id !== errorId);
      if (shown) ids.push(errorId);
      if (ids.length) el.setAttribute('aria-describedby', ids.join(' '));
      else el.removeAttribute('aria-describedby');
    };

    const announcer = document.createElement('div');
    announcer.setAttribute('aria-live', 'polite');
    announcer.classList.add('visually-hidden');
    document.body.append(announcer);
    let announceTimer: ReturnType<typeof setTimeout> | undefined;
    let announcedField: ValidatableControl | undefined;

    const spokenText = (node: Node): string => {
      const copy = node.cloneNode(true) as Element;
      copy.querySelectorAll('[aria-hidden="true"]').forEach((n) => n.remove());
      copy.querySelectorAll('[role="img"][aria-label]').forEach((n) => {
        n.replaceWith(`${n.getAttribute('aria-label')}: `);
      });
      return (copy.textContent || '').replace(/\s+/g, ' ').trim();
    };

    const announceError = (el: ValidatableControl) => {
      const errorId = el.dataset.error;
      if (!errorId) return;
      const errorEl = document.getElementById(errorId);
      if (!errorEl) return;
      const label = el.labels?.[0] ? `${spokenText(el.labels[0])}: ` : '';
      clearTimeout(announceTimer);
      announcer.textContent = '';
      announcedField = el;
      announceTimer = setTimeout(() => {
        announcer.textContent = label + spokenText(errorEl);
      }, 500);
    };

    const flagged = new WeakSet<ValidatableControl>();
    const announced = new WeakSet<ValidatableControl>();

    const syncAria = (el: ValidatableControl, announce = false) => {
      if (el instanceof HTMLInputElement && el.type === 'radio') return;
      const invalid = el.matches(':user-invalid');
      if (invalid) {
        if (announce && !announced.has(el)) {
          announceError(el);
          announced.add(el);
        }
        el.setAttribute('aria-invalid', 'true');
        linkError(el, true);
        flagged.add(el);
      } else if (flagged.has(el) || el.getAttribute('aria-invalid') !== 'true') {
        el.setAttribute('aria-invalid', 'false');
        linkError(el, false);
        flagged.delete(el);
        announced.delete(el);
        if (announcedField === el) {
          clearTimeout(announceTimer);
          announcer.textContent = '';
        }
      }
    };

    const updatePhoneMode = (mode: PhoneType) => {
      if (!phoneInput) return;

      if (mode === 'landline') {
        phoneInput.pattern = LANDLINE_PATTERN;
        phoneInput.placeholder = '例如：0225418826';
        if (phoneHint) {
          phoneHint.textContent = '（含區碼，雙北 02 為 10 碼，桃竹等為 9 碼）';
        }
        if (phoneErrorText) {
          phoneErrorText.textContent = '請輸入正確市話號碼（含區碼，例如雙北 0225418826、桃竹 035123456）。';
        }
        if (phoneExtWrapper) phoneExtWrapper.classList.remove('hidden');
        if (phoneExtInput) phoneExtInput.disabled = false;
      } else {
        phoneInput.pattern = MOBILE_PATTERN;
        phoneInput.placeholder = '例如：0912345678';
        if (phoneHint) {
          phoneHint.textContent = '（09 開頭 10 碼）';
        }
        if (phoneErrorText) {
          phoneErrorText.textContent = '請輸入 09 開頭的 10 位手機號碼（例如：0912345678）。';
        }
        if (phoneExtWrapper) phoneExtWrapper.classList.add('hidden');
        if (phoneExtInput) {
          phoneExtInput.value = '';
          phoneExtInput.disabled = true;
          phoneExtInput.setCustomValidity('');
          syncAria(phoneExtInput);
        }
      }

      phoneInput.setCustomValidity('');
      syncAria(phoneInput);
    };

    const applyCustomMessage = (el: ValidatableControl) => {
      if (el === phoneInput) {
        const mode = getPhoneType();
        if (phoneInput.validity.valueMissing) {
          phoneInput.setCustomValidity('請輸入聯絡電話');
        } else if (mode === 'mobile') {
          if (phoneInput.validity.patternMismatch || !MOBILE_PHONE_REGEX.test(phoneInput.value)) {
            phoneInput.setCustomValidity('請輸入 09 開頭的 10 位手機號碼（例如：0912345678）');
          } else {
            phoneInput.setCustomValidity('');
          }
        } else if (phoneInput.validity.patternMismatch || !LANDLINE_PHONE_REGEX.test(phoneInput.value)) {
          phoneInput.setCustomValidity('請輸入正確市話號碼（含區碼，例如雙北 0225418826、桃竹 035123456）');
        } else {
          phoneInput.setCustomValidity('');
        }
      } else if (el === phoneExtInput) {
        if (
          !phoneExtInput.disabled &&
          phoneExtInput.value &&
          (phoneExtInput.validity.patternMismatch || !PHONE_EXT_REGEX.test(phoneExtInput.value))
        ) {
          phoneExtInput.setCustomValidity('分機請輸入 1–6 位純數字');
        } else {
          phoneExtInput.setCustomValidity('');
        }
      } else if (el === emailInput) {
        if (emailInput.validity.typeMismatch || emailInput.validity.patternMismatch) {
          emailInput.setCustomValidity('請輸入正確的電子信箱格式（例如：name@example.com）');
        } else {
          emailInput.setCustomValidity('');
        }
      }
    };

    // 初始化 aria-invalid="false" 與電話模式
    form.querySelectorAll('input, select, textarea').forEach((node) => {
      if (isValidatableControl(node)) {
        syncAria(node);
      }
    });

    phoneTypeRadios.forEach((radio) => {
      radio.addEventListener('change', () => {
        updatePhoneMode(getPhoneType());
      });
    });

    if (phoneInput) {
      const handlePhoneInput = () => {
        const cleaned = sanitizeDigits(phoneInput.value, 10);
        if (phoneInput.value !== cleaned) {
          phoneInput.value = cleaned;
        }
        phoneInput.setCustomValidity('');
      };

      phoneInput.addEventListener('input', (e) => {
        if ((e as InputEvent).isComposing) {
          phoneInput.setCustomValidity('');
          return;
        }
        handlePhoneInput();
      });

      phoneInput.addEventListener('compositionend', handlePhoneInput);
    }

    if (phoneExtInput) {
      const handlePhoneExtInput = () => {
        const cleaned = sanitizeDigits(phoneExtInput.value, 6);
        if (phoneExtInput.value !== cleaned) {
          phoneExtInput.value = cleaned;
        }
        phoneExtInput.setCustomValidity('');
      };

      phoneExtInput.addEventListener('input', (e) => {
        if ((e as InputEvent).isComposing) {
          phoneExtInput.setCustomValidity('');
          return;
        }
        handlePhoneExtInput();
      });

      phoneExtInput.addEventListener('compositionend', handlePhoneExtInput);
    }

    if (emailInput) {
      emailInput.addEventListener('input', () => {
        emailInput.setCustomValidity('');
      });
    }

    form.addEventListener(
      'blur',
      (e) => {
        if (!isValidatableControl(e.target)) return;
        if (e.target === phoneInput) {
          const cleaned = sanitizeDigits(phoneInput.value, 10);
          if (phoneInput.value !== cleaned) phoneInput.value = cleaned;
          phoneInput.setCustomValidity('');
        } else if (e.target === phoneExtInput) {
          const cleaned = sanitizeDigits(phoneExtInput.value, 6);
          if (phoneExtInput.value !== cleaned) phoneExtInput.value = cleaned;
          phoneExtInput.setCustomValidity('');
        } else if (e.target === emailInput) {
          emailInput.value = emailInput.value.trim();
          emailInput.setCustomValidity('');
        }
        syncAria(e.target, true);
      },
      true
    );

    form.addEventListener('input', (e) => {
      if (!isValidatableControl(e.target)) return;
      if (e.target.hasAttribute('aria-invalid')) {
        syncAria(e.target);
      }
    });

    form.addEventListener(
      'invalid',
      (e) => {
        if (!isValidatableControl(e.target)) return;
        applyCustomMessage(e.target);
        announced.add(e.target);
        syncAria(e.target);
      },
      true
    );

    form.addEventListener('reset', () => {
      setTimeout(() => {
        updatePhoneMode(getPhoneType());
        form.querySelectorAll('input, select, textarea').forEach((node) => {
          if (isValidatableControl(node)) {
            node.setCustomValidity('');
            syncAria(node);
          }
        });
      });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const phoneType = getPhoneType();

      // 送出前最後防線：清理並驗證電話、分機與選填 Email
      if (phoneInput) {
        phoneInput.value = sanitizeDigits(phoneInput.value, 10);
        phoneInput.setCustomValidity('');
        const isPhoneValid =
          phoneType === 'mobile'
            ? MOBILE_PHONE_REGEX.test(phoneInput.value)
            : LANDLINE_PHONE_REGEX.test(phoneInput.value);
        if (!isPhoneValid) {
          applyCustomMessage(phoneInput);
          phoneInput.reportValidity();
          phoneInput.focus();
          return;
        }
      }

      if (phoneExtInput && phoneType === 'landline') {
        phoneExtInput.value = sanitizeDigits(phoneExtInput.value, 6);
        phoneExtInput.setCustomValidity('');
        if (phoneExtInput.value && !PHONE_EXT_REGEX.test(phoneExtInput.value)) {
          applyCustomMessage(phoneExtInput);
          phoneExtInput.reportValidity();
          phoneExtInput.focus();
          return;
        }
      }

      if (emailInput) {
        emailInput.value = emailInput.value.trim();
        emailInput.setCustomValidity('');
        if (emailInput.value && !EMAIL_REGEX.test(emailInput.value)) {
          applyCustomMessage(emailInput);
          emailInput.reportValidity();
          emailInput.focus();
          return;
        }
      }

      // 檢查 Turnstile 驗證
      const turnstileResponse = form.querySelector<HTMLInputElement>('[name="cf-turnstile-response"]');
      if (!turnstileResponse || !turnstileResponse.value) {
        if (formStatus && formMessage) {
          formStatus.className = 'rounded-md p-4 mt-4 bg-red-50 text-red-800 block';
          formMessage.textContent = '請完成機器人驗證。';
        }
        return;
      }

      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;

      submitBtn.disabled = true;
      submitBtn.textContent = '傳送中...';

      try {
        const formData = new FormData(form);
        const cleanedPhone = sanitizeDigits(String(formData.get('phone') || ''), 10);
        const cleanedPhoneExt =
          phoneType === 'landline' ? sanitizeDigits(String(formData.get('phoneExt') || ''), 6) : '';
        const trimmedEmail = String(formData.get('email') || '').trim();
        const data = {
          name: String(formData.get('name') || '').trim(),
          phoneType,
          phone: cleanedPhone,
          phoneExt: cleanedPhoneExt,
          email: trimmedEmail,
          city: String(formData.get('city') || '').trim(),
          houseAge: String(formData.get('houseAge') || '').trim(),
          indoorPing: String(formData.get('indoorPing') || '').trim(),
          budget: String(formData.get('budget') || '').trim(),
          message: String(formData.get('message') || '').trim(),
          turnstileToken: turnstileResponse.value,
        };

        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        const result = (await response.json()) as { error?: string };

        if (formStatus && formMessage) {
          if (response.ok) {
            formStatus.className = 'rounded-md p-4 mt-4 bg-green-50 text-green-800 block';
            formMessage.textContent = '表單已成功送出！我們會盡快與您聯絡。';
            form.reset();
            // 重置 Turnstile
            if ((window as any).turnstile) (window as any).turnstile.reset();
          } else {
            formStatus.className = 'rounded-md p-4 mt-4 bg-red-50 text-red-800 block';
            formMessage.textContent = result.error || '送出失敗，請稍後再試。';
          }
        }
      } catch (error) {
        if (formStatus && formMessage) {
          formStatus.className = 'rounded-md p-4 mt-4 bg-red-50 text-red-800 block';
          formMessage.textContent = '送出失敗，請稍後再試或直接來電聯絡。';
        }
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = '送出表單';
      }
    });
  }
</script>
