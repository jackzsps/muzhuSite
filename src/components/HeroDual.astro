---
/**
 * HeroDual — 首頁全幅 Hero 區塊
 * 暖色調背景 + Slogan + 雙 CTA（B2C + B2B）
 */
---

<section class="relative min-h-[90vh] flex items-center justify-center overflow-hidden">
  <!-- Background: image + warm overlay -->
  <div class="absolute inset-0">
    <img
      src="/images/hero-bg.jpg"
      alt="溫暖舒適的居家空間"
      class="w-full h-full object-cover"
      loading="eager"
      fetchpriority="high"
    />
    <div
      class="absolute inset-0 bg-gradient-to-b from-brand-dark/50 via-brand-dark/30 to-brand-surface/90"
    >
    </div>
  </div>

  <!-- Content -->
  <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 text-center pt-20">
    <p
      class="text-sm sm:text-base tracking-[0.3em] text-warm-300 uppercase mb-6 font-medium"
    >
      MUZU Smart Storage Living
    </p>
    <h1
      class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight tracking-tight"
    >
      沐築系統<br />
      <span class="text-brand-rose">讓家沒有將就</span>
    </h1>
    <p
      class="text-lg sm:text-xl text-warm-200 mb-10 max-w-2xl mx-auto leading-relaxed"
    >
      從系統櫃規劃到全室收納設計，為您量身打造理想居家空間
    </p>

    <!-- Dual CTA -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="/contact/"
        class="group inline-flex items-center gap-2 px-8 py-4 rounded-full bg-brand-primary text-white font-medium text-lg hover:bg-brand-secondary transition-all duration-300 shadow-lg hover:shadow-xl"
      >
        免費預約丈量
        <svg
          class="w-5 h-5 group-hover:translate-x-1 transition-transform"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
      <a
        href="/designer/"
        class="inline-flex items-center gap-2 px-8 py-4 rounded-full bg-white/15 backdrop-blur-sm text-white font-medium text-lg border border-white/30 hover:bg-white/25 transition-all duration-300"
      >
        設計師合作洽詢
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <svg
      class="w-6 h-6 text-white/50"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
    </svg>
  </div>
</section>
