---
import { CONTACT_INFO, MENU_ITEMS } from '@/consts';
---

<footer class="bg-brand-secondary text-warm-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      <!-- Brand -->
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center gap-2 mb-4">
          <img
            src="/images/logo.jpg"
            alt="沐築系統家居"
            class="h-12 w-auto rounded-full"
            width="48"
            height="48"
          />
          <span class="text-white font-bold text-lg">MUZU 沐築</span>
        </a>
        <p class="text-warm-300 text-sm leading-relaxed">
          沐築系統，讓家沒有將就。<br />
          為您量身打造理想居家空間。
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-white font-semibold mb-4 text-base">快速連結</h3>
        <ul class="space-y-2.5">
          {
            MENU_ITEMS.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-warm-300 hover:text-white text-sm transition-colors duration-200"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href="/designer/"
              class="text-warm-300 hover:text-white text-sm transition-colors duration-200"
            >
              設計師合作
            </a>
          </li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h3 class="text-white font-semibold mb-4 text-base">聯絡我們</h3>
        <ul class="space-y-3 text-sm text-warm-300">
          <li class="flex items-start gap-2.5">
            <svg
              class="w-4 h-4 mt-0.5 shrink-0 text-warm-400"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              ></path>
            </svg>
            <span>{CONTACT_INFO.phone}</span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg
              class="w-4 h-4 mt-0.5 shrink-0 text-warm-400"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              ></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <span>{CONTACT_INFO.address}</span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg
              class="w-4 h-4 mt-0.5 shrink-0 text-warm-400"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path
                d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.515.254l2.449 3.32V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"
              ></path>
            </svg>
            <span>LINE: {CONTACT_INFO.line}</span>
          </li>
        </ul>
      </div>

      <!-- Business Hours -->
      <div>
        <h3 class="text-white font-semibold mb-4 text-base">營業時間</h3>
        <ul class="space-y-2.5 text-sm text-warm-300">
          <li>週一至週五 09:00 - 18:00</li>
          <li>週六 10:00 - 17:00</li>
          <li>週日及國定假日 公休</li>
        </ul>
        <div class="mt-6">
          <a
            href={CONTACT_INFO.lineUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#06C755] text-white text-sm font-medium hover:brightness-110 transition-all"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.515.254l2.449 3.32V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"
              ></path>
            </svg>
            LINE 諮詢
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Copyright -->
  <div class="border-t border-warm-800/20 py-6">
    <div
      class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-warm-400"
    >
      <p>
        &copy; {new Date().getFullYear()} 沐築系統家居 MUZU. All rights reserved.
      </p>
      <div class="flex gap-4">
        <a href="/privacy/" class="hover:text-warm-200 transition-colors"
          >隱私權政策</a
        >
      </div>
    </div>
  </div>
</footer>
