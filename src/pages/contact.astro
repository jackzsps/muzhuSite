---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import { CONTACT_INFO } from '@/consts';
---

<Layout title="聯絡我們 | 沐築系統家居" description="歡迎與我們聯繫，預約免費丈量或洽詢合作事宜。">
  <!-- Page Header -->
  <header class="bg-neutral-50 py-16">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-4xl font-bold text-brand-dark mb-4">聯絡我們</h1>
      <p class="text-xl text-neutral-600 max-w-2xl mx-auto">我們隨時準備好聆聽您的需求，與您一同打造美好空間。</p>
    </div>
  </header>

  <section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
      <div class="flex flex-col lg:flex-row gap-16 max-w-6xl mx-auto">
        
        <!-- Contact Form -->
        <div class="w-full lg:w-3/5">
          <h2 class="text-2xl font-bold text-brand-dark mb-6">線上諮詢</h2>
          <div class="bg-white p-6 md:p-8 rounded-lg shadow-sm border border-neutral-100">
            <ContactForm />
          </div>
        </div>

        <!-- Contact Info Sidebar -->
        <div class="w-full lg:w-2/5 space-y-10">
          <div>
            <h2 class="text-2xl font-bold text-brand-dark mb-6">聯絡資訊</h2>
            <ul class="space-y-4 text-neutral-600">
              <li class="flex items-start">
                <span class="font-bold w-20 shrink-0">電話：</span>
                <span>{CONTACT_INFO.phone}</span>
              </li>
              <li class="flex items-start">
                <span class="font-bold w-20 shrink-0">手機：</span>
                <span>{CONTACT_INFO.mobile}</span>
              </li>
              <li class="flex items-start">
                <span class="font-bold w-20 shrink-0">Email：</span>
                <a href={`mailto:${CONTACT_INFO.email}`} class="hover:text-brand-primary">{CONTACT_INFO.email}</a>
              </li>
              <li class="flex items-start">
                <span class="font-bold w-20 shrink-0">LINE ID：</span>
                <a href={CONTACT_INFO.lineUrl} target="_blank" rel="noopener noreferrer" class="hover:text-brand-primary">{CONTACT_INFO.line}</a>
              </li>
              <li class="flex items-start">
                <span class="font-bold w-20 shrink-0">營業時間：</span>
                <span>週一至週五 09:00 - 18:00<br>週六 10:00 - 17:00<br>週日及國定假日 公休</span>
              </li>
              <li class="flex items-start">
                <span class="font-bold w-20 shrink-0">地址：</span>
                <span>{CONTACT_INFO.address}</span>
              </li>
              <li class="flex items-start">
                <span class="font-bold w-20 shrink-0">負責人：</span>
                <span>{CONTACT_INFO.manager}</span>
              </li>
            </ul>
          </div>

          <!-- Map Placeholder -->
          <div>
            <h3 class="font-bold text-lg mb-4 text-brand-dark">公司位置</h3>
            <div class="w-full h-64 bg-neutral-200 rounded-lg flex items-center justify-center">
              <span class="text-neutral-500">Google Map Iframe 佔位區</span>
              <!-- <iframe src="https://www.google.com/maps/embed?..." width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy"></iframe> -->
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>
</Layout>
