---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import { CONTACT_INFO } from '@/consts';
---

<Layout title="聯絡我們 | 沐築系統家居" description="歡迎與我們聯繫，預約免費丈量或洽詢合作事宜。">
  <!-- Page Header -->
  <header class="bg-neutral-50 py-16">
    <div class="container mx-auto px-4 text-center">
      <p class="text-sm tracking-[0.25em] text-brand-primary uppercase font-bold mb-2">CONTACT</p>
      <h1 class="text-4xl font-bold text-brand-dark mb-4">聯絡我們</h1>
      <p class="text-lg text-neutral-600 max-w-2xl mx-auto">謝謝您的來訪，請留下資料，我們會第一時間與您聯絡！！</p>
    </div>
  </header>

  <section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
      <div class="flex flex-col lg:flex-row gap-16 max-w-6xl mx-auto">
        
        <!-- Contact Form -->
        <div class="w-full lg:w-3/5">
          <h2 class="text-2xl font-bold text-brand-dark mb-6">線上諮詢表單</h2>
          <ContactForm />
        </div>

        <!-- Contact Info Sidebar -->
        <div class="w-full lg:w-2/5 space-y-10">
          <div>
            <h2 class="text-2xl font-bold text-brand-dark mb-6">聯絡資訊</h2>
            <ul class="space-y-4 text-neutral-600">
              <li class="flex items-start">
                <span class="font-bold w-24 shrink-0">電話：</span>
                <a href={`tel:${CONTACT_INFO.phone}`} class="hover:text-brand-primary font-medium">{CONTACT_INFO.phone}</a>
              </li>
              <li class="flex items-start">
                <span class="font-bold w-24 shrink-0">Email：</span>
                <a href={`mailto:${CONTACT_INFO.email}`} class="hover:text-brand-primary font-medium">{CONTACT_INFO.email}</a>
              </li>
              <li class="flex items-start">
                <span class="font-bold w-24 shrink-0">LINE ID：</span>
                <a href={CONTACT_INFO.lineUrl} target="_blank" rel="noopener noreferrer" class="hover:text-brand-primary font-medium">{CONTACT_INFO.line}</a>
              </li>
              <li class="flex items-start">
                <span class="font-bold w-24 shrink-0">營業時間：</span>
                <div class="space-y-1">
                  {
                    CONTACT_INFO.businessHours.map((h) => (
                      <div>{h}</div>
                    ))
                  }
                </div>
              </li>
              <li class="flex items-start">
                <span class="font-bold w-24 shrink-0">地址：</span>
                <span>{CONTACT_INFO.address}</span>
              </li>
            </ul>
          </div>

          <!-- Map -->
          <div>
            <h3 class="font-bold text-lg mb-4 text-brand-dark">公司位置</h3>
            <div class="w-full h-64 rounded-lg overflow-hidden shadow-sm border border-neutral-200">
              <iframe
                src={`https://maps.google.com/maps?q=${encodeURIComponent(CONTACT_INFO.address)}&hl=zh-TW&z=16&output=embed`}
                width="100%"
                height="100%"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="沐築系統家居公司位置"
              ></iframe>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>
</Layout>
