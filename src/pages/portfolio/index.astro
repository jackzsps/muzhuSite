---
import Layout from '../../layouts/Layout.astro';
import CaseCard from '../../components/CaseCard.astro';

const cases = [
  {
    title: '北歐風客廳系統櫃',
    description: '一字型電視櫃搭配沉穩木質背板與格柵造型，簡約俐落提升空間質感。',
    spaceType: '客廳',
    image: import.meta.env.BASE_URL + 'images/北歐風客廳系統櫃.jpg',
    url: import.meta.env.BASE_URL + 'contact/',
  },
  {
    title: '全室系統櫃改造',
    description: '兩房一廳全屋配置，客餐廳電視牆結合精品玻璃展示櫃與多功能中島。',
    spaceType: '全室',
    image: import.meta.env.BASE_URL + 'images/全室系統櫃改造.jpg',
    url: import.meta.env.BASE_URL + 'contact/',
  },
  {
    title: '現代極簡臥室',
    description: '整面奶茶灰頂天衣櫃搭配極簡黑把手，結合木紋梳妝台與柔和間接照明，營造沉穩舒適的睡眠空間。',
    spaceType: '臥室',
    image: import.meta.env.BASE_URL + 'images/現代極簡臥室.jpg',
    url: import.meta.env.BASE_URL + 'contact/',
  },
  {
    title: '主臥衣櫃規劃',
    description: '純白頂天衣櫃結合木質開放式吊衣玄關端景，實用與美感兼具。',
    spaceType: '臥室',
    image: import.meta.env.BASE_URL + 'images/主臥衣櫃規劃.jpg',
    url: import.meta.env.BASE_URL + 'contact/',
  },
  {
    title: 'L型實用廚房',
    description: '現代灰白雙色門片搭配嵌入式電器高櫃，動線順暢的烹飪收納空間。',
    spaceType: '廚房',
    image: import.meta.env.BASE_URL + 'images/L型實用廚房.jpg',
    url: import.meta.env.BASE_URL + 'contact/',
  },
  {
    title: '精品玻璃衣帽間',
    description: '鋁框黑玻門片內嵌線條氣氛燈與抽屜櫃，打造精品飯店級更衣體驗。',
    spaceType: '臥室',
    image: import.meta.env.BASE_URL + 'images/2024-02-21 142310.jpg',
    url: import.meta.env.BASE_URL + 'contact/',
  },
  {
    title: '開放式中島餐廚',
    description: '大尺度中島結合餐桌與電器收納高櫃，完美整合餐廚動線與生活交流。',
    spaceType: '廚房',
    image: import.meta.env.BASE_URL + 'images/2024-03-03 145313(3).jpg',
    url: import.meta.env.BASE_URL + 'contact/',
  },
  {
    title: '現代簡約餐邊吧台櫃',
    description: '開放式酒架、石紋防濺背板與大容量抽屜收納，兼具調飲與備餐機能。',
    spaceType: '餐廳',
    image: import.meta.env.BASE_URL + 'images/2024-03-04 185709(6).jpg',
    url: import.meta.env.BASE_URL + 'contact/',
  },
  {
    title: '全室收納改造',
    description: '大坪數通透格局規劃，大器電視主牆延伸至餐廚中島與玄關收納。',
    spaceType: '全室',
    image: import.meta.env.BASE_URL + 'images/全室收納改造.jpg',
    url: import.meta.env.BASE_URL + 'contact/',
  },
];

const spaceTypes = ['全部', '客廳', '臥室', '廚房', '餐廳', '全室'];
---

<Layout title="作品案例 | 沐築系統家居" description="瀏覽沐築系統家居的精選案例，尋找您的居家裝潢靈感。">
  <!-- Page Header -->
  <header class="bg-neutral-50 py-16">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-4xl font-bold text-brand-dark mb-4">作品案例</h1>
      <p class="text-xl text-neutral-600 max-w-2xl mx-auto">探索我們如何將各種空間轉化為美感與實用兼具的生活場域。</p>
    </div>
  </header>

  <!-- Gallery Section -->
  <section class="py-12 md:py-16">
    <div class="container mx-auto px-4">
      
      <!-- Interactive Filter Buttons -->
      <div class="flex flex-wrap justify-center gap-3 mb-12" id="filter-container">
        {spaceTypes.map((type, index) => (
          <button
            type="button"
            data-filter={type}
            class={`filter-btn px-5 py-2.5 rounded-full text-sm font-medium transition-all duration-200 cursor-pointer ${
              index === 0
                ? 'bg-brand-primary text-white shadow-sm active-filter'
                : 'bg-neutral-100 text-neutral-600 hover:bg-neutral-200 hover:text-brand-dark'
            }`}
          >
            {type}
          </button>
        ))}
      </div>

      <!-- Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="cases-grid">
        {cases.map((c) => (
          <CaseCard {...c} />
        ))}
      </div>
      
    </div>
  </section>
  
  <section class="py-16 bg-brand-light text-center">
    <div class="container mx-auto px-4">
      <h2 class="text-2xl font-bold mb-4">找到喜歡的風格了嗎？</h2>
      <a href={import.meta.env.BASE_URL + "contact/"} class="text-brand-primary font-bold hover:underline">與我們討論您的想法 →</a>
    </div>
  </section>
</Layout>

<script>
  const filterButtons = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.case-card-item');

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selected = btn.getAttribute('data-filter') || '全部';

      filterButtons.forEach((b) => {
        b.classList.remove('bg-brand-primary', 'text-white', 'shadow-sm', 'active-filter');
        b.classList.add('bg-neutral-100', 'text-neutral-600');
      });
      btn.classList.remove('bg-neutral-100', 'text-neutral-600');
      btn.classList.add('bg-brand-primary', 'text-white', 'shadow-sm', 'active-filter');

      cards.forEach((card) => {
        const category = card.getAttribute('data-category');
        if (selected === '全部' || category === selected) {
          (card as HTMLElement).style.display = 'block';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
